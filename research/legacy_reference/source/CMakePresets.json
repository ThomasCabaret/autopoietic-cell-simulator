{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-x64",
      "displayName": "Windows x64 - Visual Studio 2022 Build Tools",
      "description": "Generator-agnostic source tree configured with the VS 2022 x64 generator and the repository vcpkg toolchain.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc-x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "PARTICLE_LIFE_BUILD_GUI": "ON",
        "PARTICLE_LIFE_BUILD_HEADLESS": "ON",
        "PARTICLE_LIFE_BUILD_REGRESSION": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "displayName": "Build Windows Debug",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "windows-release",
      "displayName": "Build Windows Release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "displayName": "Test Windows Debug",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "displayName": "Test Windows Release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
