--- a/include/particle_life/math.hpp
+++ b/include/particle_life/math.hpp
@@ -68,6 +68,10 @@ inline float dot(const Vec2& lhs, const Vec2& rhs) noexcept {
     return lhs.x * rhs.x + lhs.y * rhs.y;
 }
 
+inline float cross(const Vec2& lhs, const Vec2& rhs) noexcept {
+    return lhs.x * rhs.y - lhs.y * rhs.x;
+}
+
 inline float normSquared(const Vec2& value) noexcept {
     return dot(value, value);
 }
@@ -87,6 +91,18 @@ inline float angleFromVector(const Vec2& value) noexcept {
     return std::atan2(value.y, value.x);
 }
 
+inline float wrapAngle(float angle) noexcept {
+    const float pi = static_cast<float>(kPi);
+    const float twoPi = static_cast<float>(2.0 * kPi);
+    while (angle > pi) {
+        angle -= twoPi;
+    }
+    while (angle < -pi) {
+        angle += twoPi;
+    }
+    return angle;
+}
+
 inline Vec2 unitVectorFromAngle(float angle) noexcept {
     return {std::cos(angle), std::sin(angle)};
 }
