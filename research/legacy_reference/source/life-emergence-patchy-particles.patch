+            if (
+                particle.rightBond == kInvalidParticleId &&
+                other.leftBond == kInvalidParticleId &&
+                dot(centerDisplacement, tangent) > 0.0f &&
+                dot(centerDisplacement, otherTangent) > 0.0f) {
